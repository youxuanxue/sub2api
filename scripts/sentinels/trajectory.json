{
  "version": 4,
  "rationale": "Gateway evidence capture and raw QA archive; contract: docs/approved/qa-raw-only.md.",
  "route_source": "backend/internal/server/routes/gateway.go",
  "capture_source": "backend/internal/observability/qa/sse_tee.go",
  "required_route_hooks": [
    "trajectoryID := middleware.TrajectoryID()",
    "qaCapture = h.QACapture.Middleware()",
    "gateway.Use(trajectoryID)",
    "gateway.Use(qaCapture)",
    "gemini.Use(trajectoryID)",
    "gemini.Use(qaCapture)",
    "trajectoryID, qaCapture",
    "registerTKOpenAICompatVideoRoutesNoPrefix(rootRoutes, h, bodyLimit, clientRequestID, trajectoryID, qaCapture",
    "antigravityV1.Use(trajectoryID)",
    "antigravityV1.Use(qaCapture)",
    "antigravityV1Beta.Use(trajectoryID)",
    "antigravityV1Beta.Use(qaCapture)"
  ],
  "required_capture_hooks": [
    "func Middleware(svc *Service) gin.HandlerFunc {",
    "c.Set(contextKeyTeeWriter, tee)",
    "svc.CaptureFromContext(c)"
  ],
  "required_file_hooks": [
    {
      "source": "backend/internal/service/ops_upstream_context.go",
      "must_contain": [
        "OpsUpstreamRequestBodyKey = \"ops_upstream_request_body\""
      ],
      "rationale": "qa capture reads this gin key by duplicated literal (qa cannot import service without an import cycle); renaming the key here silently kills upstream-request divergence capture for opted-in QA records"
    },
    {
      "source": "backend/internal/observability/qa/service.go",
      "must_contain": [
        "opsUpstreamRequestBodyContextKey = \"ops_upstream_request_body\"",
        "captureUpstreamRequestBody(c, metadataBody)"
      ],
      "rationale": "consumer-side duplicate of OpsUpstreamRequestBodyKey plus the CaptureFromContext hook; either disappearing silently drops request.upstream_body / upstream_divergent from opt-in blobs"
    },
    {
      "source": "backend/internal/service/gateway_forward.go",
      "must_contain": [
        "setOpsUpstreamRequestBody(c, body)"
      ],
      "rationale": "pre-flight stash of the final upstream request body on the native anthropic path; an upstream merge dropping this call disables both ops_error_logs body context and QA divergence capture"
    }
  ],
  "semantic_route_contracts": [
    {
      "source": "backend/internal/server/routes/gateway.go",
      "required_calls": [
        {
          "name": "gatewayRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/messages"
          ]
        },
        {
          "name": "gatewayRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/chat/completions"
          ]
        },
        {
          "name": "gatewayRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/responses"
          ]
        },
        {
          "name": "geminiRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/models/*modelAction"
          ]
        },
        {
          "name": "codexRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/responses"
          ]
        },
        {
          "name": "antigravityV1Routes.Register",
          "args": [
            "raw:http.MethodPost",
            "/messages"
          ]
        },
        {
          "name": "antigravityV1BetaRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/models/*modelAction"
          ]
        }
      ]
    }
  ]
}
