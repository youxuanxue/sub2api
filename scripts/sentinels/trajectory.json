{
  "version": 4,
  "rationale": "Gateway evidence capture, entitled QA Bundle access and faithful session export hooks. Pins request divergence, committed-Bundle ZIP call sites and focused session behavior tests; the contract and owner roster live in docs/approved/qa-bundle-session-export.md.",
  "route_source": "backend/internal/server/routes/gateway.go",
  "capture_source": "backend/internal/observability/qa/sse_tee.go",
  "required_route_hooks": [
    "trajectoryID := middleware.TrajectoryID()",
    "qaCapture = h.QACapture.Middleware()",
    "gateway.Use(trajectoryID)",
    "gateway.Use(qaCapture)",
    "gemini.Use(trajectoryID)",
    "gemini.Use(qaCapture)",
    "trajectoryID, qaCapture",
    "registerTKOpenAICompatVideoRoutesNoPrefix(rootRoutes, h, bodyLimit, clientRequestID, trajectoryID, qaCapture",
    "antigravityV1.Use(trajectoryID)",
    "antigravityV1.Use(qaCapture)",
    "antigravityV1Beta.Use(trajectoryID)",
    "antigravityV1Beta.Use(qaCapture)"
  ],
  "required_capture_hooks": [
    "func Middleware(svc *Service) gin.HandlerFunc {",
    "c.Set(contextKeyTeeWriter, tee)",
    "svc.CaptureFromContext(c)"
  ],
  "required_file_hooks": [
    {
      "source": "backend/internal/service/ops_upstream_context.go",
      "must_contain": [
        "OpsUpstreamRequestBodyKey = \"ops_upstream_request_body\""
      ],
      "rationale": "qa capture reads this gin key by duplicated literal (qa cannot import service without an import cycle); renaming the key here silently kills upstream-request divergence capture for opted-in QA records"
    },
    {
      "source": "backend/internal/observability/qa/service.go",
      "must_contain": [
        "opsUpstreamRequestBodyContextKey = \"ops_upstream_request_body\"",
        "captureUpstreamRequestBody(c, metadataBody)"
      ],
      "rationale": "consumer-side duplicate of OpsUpstreamRequestBodyKey plus the CaptureFromContext hook; either disappearing silently drops request.upstream_body / upstream_divergent from opt-in blobs"
    },
    {
      "source": "backend/internal/service/gateway_forward.go",
      "must_contain": [
        "setOpsUpstreamRequestBody(c, body)"
      ],
      "rationale": "pre-flight stash of the final upstream request body on the native anthropic path; an upstream merge dropping this call disables both ops_error_logs body context and QA divergence capture"
    },
    {
      "source": "backend/internal/handler/qa_handler_bundle.go",
      "must_contain": [
        "requireTrajectoryExportEnabled",
        "CreateSelfQABundle",
        "CreateSelfQABundleExport"
      ],
      "rationale": "Every QA Bundle create/read/export handler must retain the admin-granted entitlement check before reaching S3 Bundle job state. An upstream merge dropping this guard would expose archived QA data to accounts without the entitlement."
    },
    {
      "source": "backend/internal/observability/qa/service_bundle.go",
      "must_contain": [
        "func (s *Service) UserTrajExportEnabled",
        "func (s *Service) UserMayExportAPIKey",
        "engine.TrajProjectablePlatforms()",
        "apikey.UserIDEQ",
        "bundle.NewBundleJobSpec",
        "latestCompleteBundleWatermark"
      ],
      "rationale": "The Bundle service repeats entitlement, API-key ownership, and eligible-platform authorization, derives only continuous restore-verified archive windows, and creates deterministic S3 job specs. It must never query prod QA records as a fallback."
    },
    {
      "source": "backend/internal/engine/provider.go",
      "must_contain": [
        "func TrajProjectablePlatforms"
      ],
      "rationale": "Single source for platforms eligible for the per-key QA Bundle entry; surfaced through /auth/me and rechecked by the Bundle service. Removing it would split frontend gating from backend authorization."
    },
    {
      "source": "backend/internal/observability/qa/bundle/publisher.go",
      "rationale": "Every current-version ZIP projects the same committed records and publishes sessions before immutable ZIP publication.",
      "must_contain": [
        "projector.Add(ctx, sessionInput(record))",
        "writeSessionExport(ctx, zipWriter, projector, manifest)"
      ]
    },
    {
      "source": "backend/internal/observability/trajectory/session.go",
      "rationale": "Single session association, provenance and tool-link owner; payloads and indexes are disk-backed.",
      "must_contain": [
        "func (e *SessionExporter) Add(",
        "func (e *SessionExporter) WriteTo(",
        "func (e *SessionExporter) appendTurn("
      ]
    },
    {
      "source": "backend/internal/observability/qa/bundle/session_export_test.go",
      "rationale": "Behavior anchors prevent a green test command with no session ZIP coverage.",
      "must_contain": [
        "func TestUS055_BundleSessionZip(",
        "func TestUS055_BundleSessionZipRejectsCorruptPageAndCancellation(",
        "func TestUS055_ExportVersionIsImmutableAndLegacyJobsRemainReadable("
      ]
    },
    {
      "source": "backend/internal/observability/trajectory/session_test.go",
      "rationale": "Core session, reasoning fidelity and isolation regression anchors.",
      "must_contain": [
        "func TestUS055_SessionsReconstructInterleavedToolChain(",
        "func TestUS055_ResponsesReasoningAndNativeFieldsSurvive(",
        "func TestUS055_SessionsNeverGuessAcrossScopeRetriesOrAmbiguity("
      ]
    }
  ],
  "semantic_route_contracts": [
    {
      "source": "backend/internal/server/routes/gateway.go",
      "required_calls": [
        {
          "name": "gatewayRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/messages"
          ]
        },
        {
          "name": "gatewayRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/chat/completions"
          ]
        },
        {
          "name": "gatewayRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/responses"
          ]
        },
        {
          "name": "geminiRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/models/*modelAction"
          ]
        },
        {
          "name": "codexRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/responses"
          ]
        },
        {
          "name": "antigravityV1Routes.Register",
          "args": [
            "raw:http.MethodPost",
            "/messages"
          ]
        },
        {
          "name": "antigravityV1BetaRoutes.Register",
          "args": [
            "raw:http.MethodPost",
            "/models/*modelAction"
          ]
        }
      ]
    }
  ]
}
