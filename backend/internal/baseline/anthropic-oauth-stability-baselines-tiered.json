{
  "schema_version": 1,
  "description": "Human-paced Anthropic OAuth stability baselines for Claude Code account operation.",
  "policy": {
    "single_account_scope": true,
    "rate_multiplier_fixed": 1.0,
    "usage_model": "Claude Code human-paced work: usage budget and session length are constrained separately; lower tiers are scheduled first but reach their local limits earlier.",
    "tier_order": [
      "l1",
      "l2",
      "l3",
      "l4",
      "l5"
    ],
    "escalation_model": "code-owned",
    "cooldown_ladder_seconds": [
      30,
      120,
      600
    ],
    "cooldown_tier_ttl_minutes": 30,
    "rounding": {
      "integer_fields": "explicit",
      "float_fields": "explicit"
    }
  },
  "shared_baseline": {
    "account": {
      "platform": "anthropic",
      "type": "oauth",
      "proxy_id": null,
      "load_factor": null,
      "auto_pause_on_expired": true,
      "channel_type": 0
    },
    "credentials": {
      "intercept_warmup_requests": true,
      "temp_unschedulable_enabled": true,
      "temp_unschedulable_rules": [
        {
          "error_code": 403,
          "keywords": [
            "account_disabled_auth_error",
            "organization disabled"
          ],
          "duration_minutes": 360,
          "description": "\u8d26\u53f7\u6216\u7ec4\u7ec7\u7981\u7528 - \u6682\u505c 6 \u5c0f\u65f6\uff08\u4e8c\u6b21\u547d\u4e2d\u7531 handle403 \u5347\u7ea7\u4e3a SetError\uff09"
        }
      ]
    },
    "extra": {
      "enable_tls_fingerprint": true,
      "rpm_strategy": "tiered",
      "user_msg_queue_mode": "serialize",
      "session_id_masking_enabled": true,
      "cache_ttl_override_enabled": true,
      "cache_ttl_override_target": "1h",
      "custom_base_url_enabled": false
    },
    "extra_absent": [
      "custom_base_url"
    ],
    "tls_profile": {
      "name": "tk_canonical_cc_oauth",
      "description": "TokenKey canonical Claude Code OAuth TLS profile. Stable id is independent of the CLI patch version. Captured from Claude Code 2.1.327 on 2026-11-18 (Node v26.12.1 darwin/arm64): X25519MLKEM768 and X25519 key shares, no padding extension. HTTP observed.user_agent remains a compile-time snapshot; live UA uses SettingService.GetClaudeCodeUserAgentVersion.",
      "enable_grease": false,
      "cipher_suites": [
        4865,
        4866,
        4867,
        49195,
        49199,
        49196,
        49200,
        52393,
        52392,
        49161,
        49171,
        49162,
        49172,
        156,
        157,
        47,
        53
      ],
      "curves": [
        4588,
        29,
        23,
        24
      ],
      "point_formats": [
        0
      ],
      "signature_algorithms": [
        1027,
        2052,
        1025,
        1283,
        2053,
        1281,
        2054,
        1537,
        2055,
        1539,
        513
      ],
      "alpn_protocols": [
        "http/1.1"
      ],
      "supported_versions": [
        772,
        771
      ],
      "key_share_groups": [
        4588,
        29
      ],
      "psk_modes": [
        1
      ],
      "extensions": [
        0,
        23,
        65281,
        10,
        11,
        35,
        16,
        5,
        13,
        18,
        51,
        45,
        43
      ]
    }
  },
  "tiers": {
    "l1": {
      "baseline": {
        "account": {
          "concurrency": 30,
          "priority": 1,
          "rate_multiplier": 1.0
        },
        "extra": {
          "base_rpm": 60,
          "rpm_sticky_buffer": 15,
          "max_sessions": 300,
          "session_idle_timeout_minutes": 8
        }
      }
    },
    "l2": {
      "baseline": {
        "account": {
          "concurrency": 30,
          "priority": 1,
          "rate_multiplier": 1.0
        },
        "extra": {
          "base_rpm": 60,
          "rpm_sticky_buffer": 15,
          "max_sessions": 300,
          "session_idle_timeout_minutes": 8,
          "cache_ttl_override_enabled": true
        }
      }
    },
    "l3": {
      "baseline": {
        "account": {
          "concurrency": 30,
          "priority": 1,
          "rate_multiplier": 1.0
        },
        "extra": {
          "base_rpm": 60,
          "rpm_sticky_buffer": 15,
          "max_sessions": 300,
          "session_idle_timeout_minutes": 8
        }
      }
    },
    "l4": {
      "baseline": {
        "account": {
          "concurrency": 40,
          "priority": 1,
          "rate_multiplier": 1.0
        },
        "extra": {
          "base_rpm": 80,
          "rpm_sticky_buffer": 20,
          "max_sessions": 450,
          "session_idle_timeout_minutes": 8
        }
      }
    },
    "l5": {
      "baseline": {
        "account": {
          "concurrency": 50,
          "priority": 1,
          "rate_multiplier": 1.0
        },
        "extra": {
          "base_rpm": 100,
          "rpm_sticky_buffer": 30,
          "max_sessions": 600,
          "session_idle_timeout_minutes": 8
        }
      }
    }
  }
}
