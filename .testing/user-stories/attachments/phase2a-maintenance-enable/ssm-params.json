{
  "commands": [
    "set -euo pipefail",
    "echo === qa-maintenance timer sync ===",
    "echo  | base64 -d | sudo tee /usr/local/bin/tokenkey-qa-maintenance.sh > /dev/null",
    "sudo chmod +x /usr/local/bin/tokenkey-qa-maintenance.sh",
    "sudo /usr/local/bin/tokenkey-qa-maintenance.sh --selftest",
    "sudo /usr/local/bin/tokenkey-qa-maintenance.sh --install-units",
    "sudo install -d -m 0700 -o 1000 -g 1000 /var/lib/tokenkey/data/qa_archive_tmp",
    "sudo systemctl daemon-reload",
    "sudo systemctl enable --now tokenkey-qa-maintenance.timer",
    "test \"$(sudo systemctl is-enabled tokenkey-qa-maintenance.timer)\" = \"enabled\"",
    "test \"$(sudo systemctl is-active tokenkey-qa-maintenance.timer)\" = \"active\"",
    "sudo systemctl list-timers tokenkey-qa-maintenance.timer --no-pager || true",
    "echo Live qa-maintenance units now match deploy/aws@local timer=enabled on $(hostname)"
  ]
}
