{
  "commands": [
    "set -euo pipefail",
    "printf %s '' | base64 -d | gunzip | sudo tee /usr/local/bin/tokenkey-qa-stale-cleanup.sh >/dev/null",
    "sudo chmod +x /usr/local/bin/tokenkey-qa-stale-cleanup.sh",
    "sudo /usr/local/bin/tokenkey-qa-stale-cleanup.sh --install-units",
    "sudo systemctl daemon-reload",
    "sudo systemctl disable --now tokenkey-qa-stale-cleanup.timer",
    "test \"$(sudo systemctl is-enabled tokenkey-qa-stale-cleanup.timer)\" = \"disabled\"",
    "test \"$(sudo systemctl is-active tokenkey-qa-stale-cleanup.timer)\" = \"inactive\""
  ]
}
