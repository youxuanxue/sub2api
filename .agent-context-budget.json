{
  "groups": [
    {
      "name": "root-entrypoints",
      "patterns": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "max_file_bytes": 7000,
      "max_total_bytes": 10500
    },
    {
      "name": "rules",
      "patterns": [
        ".cursor/rules/*.mdc"
      ],
      "max_file_bytes": 7000,
      "max_total_bytes": 16000
    },
    {
      "name": "skills",
      "patterns": [
        ".cursor/skills/*/SKILL.md"
      ],
      "max_file_bytes": 9000,
      "max_total_bytes": 160000
    },
    {
      "name": "reference-navigation",
      "patterns": [
        "docs/global/agent-reference.md"
      ],
      "max_file_bytes": 10000,
      "max_total_bytes": 10000
    }
  ],
  "references": [
    ".cursor/skill-index.md",
    ".cursor/skills/*/references/*.md",
    "dev-rules/docs/agent-guides/*.md"
  ]
}
