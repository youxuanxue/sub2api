{
  "schema_version": 1,
  "platform": "ec2",
  "default_profile": "edge-minimal",
  "_migration": "EC2 targets remain shadow candidates until the per-edge owner cutover sets deployable=true and migration_candidate=false.",
  "targets": {
    "us3": {
      "deployable": false,
      "migration_candidate": true,
      "profile": "edge-minimal",
      "region": "us-east-2",
      "domain": "api-us3.tokenkey.dev",
      "stack": "tokenkey-edge-us3-stage0",
      "instance_type": "t4g.small",
      "root_volume_gib": 20,
      "data_volume_gib": 20,
      "swap_gib": 2,
      "snapshot_schedule": "daily",
      "ssm_prefix": "/tokenkey/edge/us3",
      "purpose": "all-edge-platform-migration-candidate"
    },
