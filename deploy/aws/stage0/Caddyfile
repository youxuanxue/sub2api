# tokenkey · AWS Stage 0 · Caddyfile
# -----------------------------------------------------------------------------
# Cloud-Init 会用 envsubst 把 ${API_DOMAIN}/${ACME_EMAIL}/${SITE_DOMAIN} 替换为
# 实际值；SITE_DOMAIN 为空时 render-prod-caddyfile.sh 会删掉 apex 块。
# Caddy 通过 TLS-ALPN-01（443 上）自动申请并续签 Let's Encrypt 证书。
# 不用 HTTP-01：公网 80 已在 AWS 安全组层关闭，证书签发/续签不依赖 80。
#
# 阶段二（canonical）：SITE_DOMAIN（如 tokenkey.dev）主 serving；API_DOMAIN 仅
# gateway / health / 服务端 webhook（@machine allowlist），其余 301 → SITE_DOMAIN。
# 无 SITE_DOMAIN 时（localhost / edge）API 块走全量 reverse_proxy。
# -----------------------------------------------------------------------------

{
	email ${ACME_EMAIL}
	# 取消下一行注释可改用 staging（联调时避免触发 LE 速率限制）
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

(tokenkey_tls) {
	tls {
		protocols tls1.2 tls1.3
		issuer acme {
			email ${ACME_EMAIL}
			disable_http_challenge
		}
	}
}

(tokenkey_encode_static) {
	encode zstd gzip

	@static {
		path /assets/*
		path /logo.png
		path /favicon.ico
		path /og-cover.png
		path /seedance-official-showcase-b1aff7ba.mp4
		path /seedance-official-poster-ad98e92e.jpg
	}
	header @static ?Cache-Control "public, max-age=31536000, immutable"
}

(tokenkey_reverse_proxy) {
	reverse_proxy tokenkey:8080 {
		flush_interval -1
		# Active health 走 /health（drain-aware）：SIGUSR1 → /health=503 →
		# Caddy active 立刻把 upstream 摘除，发版排空窗口期间 0 新流量打到老
		# 容器。注意：docker healthcheck 用 /health/live（不受 drain 影响），
		# 避免 drain 触发 docker 自动 restart；Caddy active health 没有 auto-
		# restart 副作用，只决定要不要继续转发，所以 drain-aware 是正确选择。
		health_uri /health
		health_interval 5s
		health_timeout 3s
		# Passive health（top-level，不能放进 sub-block）：覆盖 stop→start 短暂
		# 真空期里 dial 失败 / 502 / gateway-timeout 504 的场景。
		# 故意 NOT 含 503：app 的 503（no available accounts / overloaded）是
		# 应用层的合法响应，不代表后端进程坏了。单上游下，因一个 503 把唯一后端
		# 标 unhealthy 零 failover 收益（无处可转），只会让后续请求落进
		# lb_try_duration 干等 30s——一个 per-request 503 被放大成全节点停摆
		# （503 风暴时每个 503 重新点燃 5s unhealthy 窗，后端持续 down）。真宕机
		# 仍由 502/504 兜住；发版排空走 active health（drain → /health=503），与
		# 被动 unhealthy_status 无关，不受影响。
		fail_duration 5s
		max_fails 1
		unhealthy_status 502 504
		# 落进 unhealthy 后，新请求在 Caddy 侧排队重试最多 30s，覆盖 stop→start
		# 的短真空期。曾抬到 120s 想盖住整个发版空窗（含 pre-drain ≤76s），但
		# lb_try_duration 对 Caddy 无差别：真宕机时它会把每个请求干等放大 4 倍、
		# 挂起连接堆积 ×4，瘦机器（t4g.small/micro）上可能反把 Caddy 拖垮。故回退
		# 30s 保「快速失败 + 不堆积」；发版空窗改由运维侧规避（闲时发版），根治走
		# blue-green（始终有健康容器，无空窗，届时 30s 也够）。
		lb_try_duration 30s
		lb_try_interval 1s
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 5s
			keepalive 120s
			keepalive_idle_conns 64
			compression off
		}
	}
}

(tokenkey_limits_log) {
	request_body {
		max_size 100MB
	}

	log {
		output stdout
		format json
		level INFO
	}
}

# BEGIN_APEX_VHOST
${SITE_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static
	import tokenkey_reverse_proxy
	import tokenkey_limits_log
}
# END_APEX_VHOST

# BEGIN_GLOBAL_VHOST
${GLOBAL_SITE_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static

	@global_home {
		path /
		path /home
	}
	handle @global_home {
# BEGIN_GLOBAL_NOINDEX
		header X-Robots-Tag "noindex, nofollow"
# END_GLOBAL_NOINDEX
		import tokenkey_reverse_proxy
	}

	@global_runtime {
		path /assets/*
		path /logo.png
		path /favicon.ico
		path /og-cover.png
		path /seedance-official-showcase-b1aff7ba.mp4
		path /seedance-official-poster-ad98e92e.jpg
	}
	handle @global_runtime {
		import tokenkey_reverse_proxy
	}

	@global_public_settings {
		method GET
		path /api/v1/settings/public
	}
	@global_session_refresh {
		method POST
		path /api/v1/auth/refresh
	}
	@global_session_user {
		method GET
		path /api/v1/auth/me
	}
	handle @global_public_settings {
		import tokenkey_reverse_proxy
	}
	handle @global_session_refresh {
		import tokenkey_reverse_proxy
	}
	handle @global_session_user {
		import tokenkey_reverse_proxy
	}

	handle {
		redir https://${SITE_DOMAIN}{uri} ${GLOBAL_REDIRECT_STATUS}
	}

	import tokenkey_limits_log
}
# END_GLOBAL_VHOST

${API_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static

# BEGIN_API_FULL_PROXY
	import tokenkey_reverse_proxy
# END_API_FULL_PROXY

# BEGIN_API_MACHINE_SPLIT
	@machine {
		path /health*
		path /v1/*
		path /openrouter/*
		path /v1beta/*
		path /api/v1/auth/oauth/*/callback
		path /api/v1/auth/oauth/*/*/callback
		path /api/v1/payment/webhook/*
		path /api/event_logging/batch
		# Gateway root aliases (backend/internal/server/routes/gateway.go)
		path /backend-api/codex/*
		path /antigravity/*
		path /responses*
		path /chat/completions*
		path /embeddings*
		path /models
		path /images/*
		path /messages/count_tokens
		path /alpha/search
		path /videos*
		path /video/*
	}
	handle @machine {
		import tokenkey_reverse_proxy
	}
	handle {
		redir https://${SITE_DOMAIN}{uri} permanent
	}
# END_API_MACHINE_SPLIT

	import tokenkey_limits_log
}
