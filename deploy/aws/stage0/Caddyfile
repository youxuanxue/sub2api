# tokenkey · AWS Stage 0 · Caddyfile
# -----------------------------------------------------------------------------
# Cloud-Init 会用 envsubst 把 ${API_DOMAIN}/${ACME_EMAIL}/${SITE_DOMAIN} 替换为
# 实际值；SITE_DOMAIN 为空时 render-prod-caddyfile.sh 会删掉 apex 块。
# Caddy 通过 TLS-ALPN-01（443 上）自动申请并续签 Let's Encrypt 证书。
# 不用 HTTP-01：公网 80 已在 AWS 安全组层关闭，证书签发/续签不依赖 80。
#
# 阶段二（canonical）：SITE_DOMAIN（如 tokenkey.dev）主 serving；API_DOMAIN 仅
# gateway / health / 服务端 webhook（@machine allowlist），其余 301 → SITE_DOMAIN。
# 无 SITE_DOMAIN 时（localhost）API 块走全量 reverse_proxy。
# -----------------------------------------------------------------------------

{
	email ${ACME_EMAIL}
	# 取消下一行注释可改用 staging（联调时避免触发 LE 速率限制）
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

(tokenkey_tls) {
	tls {
		protocols tls1.2 tls1.3
		issuer acme {
			email ${ACME_EMAIL}
			disable_http_challenge
		}
	}
}

(tokenkey_encode_static) {
	# Encode whitelist must match deploy/Caddyfile (SSOT; caddyfile-syntax gate).
	# Never shorthand `encode zstd gzip` / `text/*` — buffers SSE keepalives.
	encode {
		zstd
		gzip 6
		minimum_length 256
		match {
			# 不使用 text/*，否则 text/event-stream 会被压缩并缓冲到流结束
			header Content-Type text/css*
			header Content-Type text/csv*
			header Content-Type text/html*
			header Content-Type text/javascript*
			header Content-Type text/markdown*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
		}
	}

	@static {
		path /assets/*
		path /logo.png
		path /favicon.ico
		path /og-cover.png
		path /seedance-2-5-official-showcase-8b37bc3e.mp4
		path /seedance-2-5-official-poster-db3ff793.jpg
	}
	header @static ?Cache-Control "public, max-age=31536000, immutable"
}

(tokenkey_reverse_proxy) {
	reverse_proxy tokenkey:8080 {
		flush_interval -1
		# Active health 走 /health（drain-aware）：SIGUSR1 → /health=503 →
		# Caddy active 立刻把 upstream 摘除，发版排空窗口期间 0 新流量打到老
		# 容器。注意：docker healthcheck 用 /health/live（不受 drain 影响），
		# 避免 drain 触发 docker 自动 restart；Caddy active health 没有 auto-
		# restart 副作用，只决定要不要继续转发，所以 drain-aware 是正确选择。
		health_uri /health
		health_interval 5s
		health_timeout 3s
		# Single-backend health policy: only /health may remove the active app.
		# Passive failures also count downstream upload resets and business 5xx;
		# cooling the sole backend makes unrelated requests wait 2–6s. Removing
		# unhealthy_status alone is insufficient: transport failures still count.
		# Keep bounded retries for actual downtime and active-health recovery.
		lb_try_duration 30s
		lb_try_interval 1s
		header_up -CF-Connecting-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 5s
			keepalive 120s
			keepalive_idle_conns 64
			compression off
		}
	}
}

(tokenkey_limits_log) {
	request_body {
		max_size 100MB
	}

	log {
		output stdout
		format json
		level INFO
	}
}

# BEGIN_APEX_VHOST
${SITE_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static

	# Public /privacy /terms (OR compliance). Host files: caddy/data/legal/
	handle /privacy {
		root * /data/legal
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		root * /data/legal
		rewrite * /terms.html
		file_server
	}
	handle_path /legal-assets/* {
		root * /data/legal
		file_server
	}

	import tokenkey_reverse_proxy
	import tokenkey_limits_log
}
# END_APEX_VHOST

# BEGIN_GLOBAL_VHOST
# CallModel (or other GLOBAL_SITE_DOMAIN) full product facade: same SPA upstream as
# apex. Admin stays on SITE_DOMAIN only. GLOBAL_REDIRECT_STATUS applies to /admin*.
${GLOBAL_SITE_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static

	@callmodel_admin {
		path /admin*
	}
	handle @callmodel_admin {
		redir https://${SITE_DOMAIN}{uri} ${GLOBAL_REDIRECT_STATUS}
	}

	handle /privacy {
		root * /data/legal
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		root * /data/legal
		rewrite * /terms.html
		file_server
	}
	handle_path /legal-assets/* {
		root * /data/legal
		file_server
	}

	import tokenkey_reverse_proxy
	import tokenkey_limits_log
}
# END_GLOBAL_VHOST

# BEGIN_API_MACHINE_SNIPPET
# Shared @machine allowlist for API_DOMAIN and optional API_ALIAS_DOMAIN.
# Catch-all human redirect stays in each vhost — alias must land on GLOBAL_SITE_DOMAIN.
(tokenkey_api_machine) {
	@machine {
		path /health*
		path /v1/*
		path /openrouter/*
		path /v1beta/*
		path /api/v1/auth/oauth/*/callback
		path /api/v1/auth/oauth/*/*/callback
		path /api/v1/payment/webhook/*
		path /api/event_logging/batch
		# Gateway root aliases (backend/internal/server/routes/gateway.go)
		path /backend-api/codex/*
		path /antigravity/*
		path /responses*
		path /chat/completions*
		path /embeddings*
		path /models
		path /images/*
		path /messages/count_tokens
		path /alpha/search
		path /videos*
		path /video/*
	}
	handle @machine {
		import tokenkey_reverse_proxy
	}
}
# END_API_MACHINE_SNIPPET

${API_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static

# BEGIN_API_FULL_PROXY
	import tokenkey_reverse_proxy
# END_API_FULL_PROXY

# BEGIN_API_MACHINE_SPLIT
	import tokenkey_api_machine
	handle {
		redir https://${SITE_DOMAIN}{uri} permanent
	}
# END_API_MACHINE_SPLIT

	import tokenkey_limits_log
}

# BEGIN_API_ALIAS_VHOST
${API_ALIAS_DOMAIN} {
	import tokenkey_tls
	import tokenkey_encode_static
	import tokenkey_api_machine
	handle {
		redir https://${GLOBAL_SITE_DOMAIN}{uri} permanent
	}
	import tokenkey_limits_log
}
# END_API_ALIAS_VHOST
