{
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
    "model": "${model}",
    "messages": [
      {
        "role": "user",
        "content": "Compute 173*29 + 47*83 - 61*37 carefully. Reply with the final integer only."
      }
    ],
    "max_completion_tokens": 16384,
    "reasoning_effort": "low",
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  },
  "stream": true,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ],
  "thinking_validation": "request_acceptance",
  "expected_answer": "6661"
}
