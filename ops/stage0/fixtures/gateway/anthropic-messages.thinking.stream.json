{
  "method": "POST",
  "path": "/v1/messages",
  "body": {
    "model": "${model}",
    "messages": [
      {
        "role": "user",
        "content": "Compute 173*29 + 47*83 - 61*37 carefully. Reply with the final integer only."
      }
    ],
    "max_tokens": 16384,
    "thinking": {
      "type": "enabled",
      "budget_tokens": 1024
    },
    "stream": true
  },
  "stream": true,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ],
  "thinking_validation": "request_acceptance",
  "expected_answer": "6661"
}
