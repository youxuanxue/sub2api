{
  "method": "POST",
  "path": "/v1/messages",
  "body": {
    "model": "${model}",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "image",
            "source": {
              "type": "base64",
              "media_type": "image/png",
              "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jRZkAAAAASUVORK5CYII="
            }
          },
          {
            "type": "text",
            "text": "Describe this image in one word."
          }
        ]
      }
    ],
    "max_tokens": 16384,
    "stream": true
  },
  "stream": true,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
