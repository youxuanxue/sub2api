{
  "method": "POST",
  "path": "/v1/messages",
  "body": {
    "model": "${model}",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "image",
            "source": {
              "type": "base64",
              "media_type": "image/png",
              "data": ""
            }
          },
          {
            "type": "text",
            "text": "What is the dominant color in this image? Reply with one English color word."
          }
        ]
      }
    ],
    "max_tokens": 16384,
    "stream": false
  },
  "stream": false,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
