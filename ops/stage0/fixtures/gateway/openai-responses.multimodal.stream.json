{
  "method": "POST",
  "path": "/v1/responses",
  "body": {
    "model": "${model}",
    "input": [
      {
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "Describe this image in one word."
          },
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jRZkAAAAASUVORK5CYII="
          }
        ]
      }
    ],
    "max_output_tokens": 2048,
    "stream": true
  },
  "stream": true,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
