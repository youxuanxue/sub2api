{
  "method": "POST",
  "path": "/v1beta/models/${model}:generateContent",
  "body": {
    "contents": [
      {
        "role": "user",
        "parts": [
          {
            "inlineData": {
              "mimeType": "image/png",
              "data": ""
            }
          },
          {
            "text": "What is the dominant color in this image? Reply with one English color word."
          }
        ]
      }
    ],
    "generationConfig": {
      "maxOutputTokens": 2048
    }
  },
  "stream": false,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
