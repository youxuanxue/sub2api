{
  "method": "POST",
  "path": "/v1beta/models/${model}:generateContent",
  "body": {
    "contents": [
      {
        "role": "user",
        "parts": [
          {
            "text": "Reply with OK."
          }
        ]
      }
    ],
    "generationConfig": {
      "maxOutputTokens": 64
    }
  },
  "stream": false,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
