{
  "method": "POST",
  "path": "/v1/responses",
  "body": {
    "model": "${model}",
    "input": [
      {
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "What is the dominant color in this image? Reply with one English color word."
          },
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,"
          }
        ]
      }
    ],
    "max_output_tokens": 2048,
    "stream": false
  },
  "stream": false,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
