{
  "method": "POST",
  "path": "/v1/messages",
  "body": {
    "model": "${model}",
    "messages": [
      {
        "role": "user",
        "content": "Work out 17 times 23 carefully, then reply with the number only."
      }
    ],
    "max_tokens": 2048,
    "thinking": {
      "type": "enabled",
      "budget_tokens": 1024
    },
    "stream": false
  },
  "stream": false,
  "assertions": [
    "protocol_envelope",
    "no_error",
    "terminal",
    "usage"
  ]
}
