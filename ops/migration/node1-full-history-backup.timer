[Unit]
Description=Node1 daily full history backup (activate only after approved cutover)
ConditionPathExists=/etc/tokenkey/node1-prod-approved.json

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=10min
Persistent=true
Unit=tokenkey-full-history-backup.service

[Install]
WantedBy=timers.target
